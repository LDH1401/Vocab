# Sao chép file này thành .env.local để chạy trên máy (npm run dev).
# Khi deploy lên Vercel, khai báo các biến này trong Project Settings → Environment Variables.

# Chuỗi kết nối MongoDB Atlas: Database → Connect → Drivers
MONGODB_URI=
# Tên database (mặc định: vocab)
MONGODB_DB=vocab

# Mật khẩu đăng nhập vào app — nên dài và khó đoán
APP_PASSWORD=

# Chuỗi ngẫu nhiên >= 32 ký tự để ký phiên đăng nhập. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
